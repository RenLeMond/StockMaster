<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StockMaster" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F8F9FF</item>
        <item name="android:dialogTheme">@style/Theme.StockMaster.Dialog</item>
    </style>

    <style name="Theme.StockMaster.Dialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowElevation">0dp</item>
    </style>
</resources>